# Public deployment identity
APP_DOMAIN=
LETSENCRYPT_EMAIL=

# MySQL runtime values. Use unique, strong values only on EC2.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_VOLUME_NAME=

# Backend external providers and OAuth secrets
TOUR_API_KEY=
WEATHER_SHORT_TERM_API_KEY=
WEATHER_MID_TERM_API_KEY=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=
ODSAY_API_KEY=
ODSAY_CACHE_MINUTES=
ODSAY_CACHE_MAX_ENTRIES=
ANIMAL_HOSPITAL_API_KEY=
ANIMAL_REGISTRATION_API_KEY=

# Public browser build value. Never place server-side secrets in VITE_*.
VITE_KAKAO_MAP_KEY=

# Optional JVM memory limit for the backend container
JAVA_TOOL_OPTIONS=
