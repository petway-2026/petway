# Copy to .env.dev.properties; loaded only by the dev Spring profile.
# Java properties syntax: no wrapping quotes; escape backslashes as \\\\.
DB_URL=jdbc:mysql://localhost:3307/petway?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=replace-with-local-password
TOUR_API_KEY=replace-with-local-key
WEATHER_SHORT_TERM_API_KEY=replace-with-local-key
WEATHER_MID_TERM_API_KEY=replace-with-local-key
OPENAI_API_KEY=replace-with-local-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=20
ODSAY_API_KEY=replace-with-odsay-server-key
ODSAY_CACHE_MINUTES=360
ODSAY_CACHE_MAX_ENTRIES=1000
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
# Kakao redirect is derived from the request origin (forwarded origin in Docker).
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
ANIMAL_REGISTRATION_API_KEY=replace-with-animal-registration-key
ANIMAL_HOSPITAL_API_KEY=replace-with-animal-hospital-key
